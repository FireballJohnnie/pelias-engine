+// pelias-tier: dual-branch expert block. Hot experts run from the VRAM bank (weights on the GPU), the others from the original tensors (weights in RAM).
+// Both branches use the router's choice unchanged; an expert that is not in a branch is turned into an id that makes that branch do no work:
+//   hot branch  : slot 0 of the bank is an all-zero expert, so a miss contributes exactly 0
+//   cold branch : id -1, which ggml-cpu skips and fills with zeros
+// For every (selected expert, token) exactly one branch holds the real result and the other holds exact zeros, so adding the two branch outputs
+// element by element loses nothing, and the rest of the block (weights, sum over the selected experts) is the stock code in the stock order:
+// the result is bit-identical to the stock path whenever the per-expert matrix products themselves are.
+ggml_tensor * llm_graph_context::build_moe_tier(
+         ggml_tensor * cur,
+         ggml_tensor * selected_experts,
+         ggml_tensor * weights,
+   const pelias_tier_layer * pt,
+                 int   il) const {
+    const int64_t n_embd_  = cur->ne[0];
+    const int64_t n_used   = selected_experts->ne[0];
+    const int64_t n_tok    = selected_experts->ne[1];
+    pelias_tier_note_dual_build(il, (int) n_tok);
+
+    // expert id -> id for each branch, by table lookup on a flat id list
+    ggml_tensor * sel = selected_experts;
+    if (!ggml_is_contiguous(sel)) {
+        sel = ggml_cont(ctx0, sel);
+    }
+    ggml_tensor * sel_flat = ggml_reshape_2d(ctx0, sel, n_used * n_tok, 1);
+
+    ggml_tensor * ids_hot  = ggml_reshape_2d(ctx0, ggml_get_rows(ctx0, pt->tab_hot,  sel_flat), n_used, n_tok);
+    ggml_tensor * ids_cold = ggml_reshape_2d(ctx0, ggml_get_rows(ctx0, pt->tab_cold, sel_flat), n_used, n_tok);
+    cb(ids_hot,  "pelias_ids_hot",  il);
+    cb(ids_cold, "pelias_ids_cold", il);
+
+    // one branch: up/gate (or the merged gate_up), SwiGLU, down  ->  [n_embd, n_used, n_tok], not yet weighted
+    auto branch = [&](ggml_tensor * w_up, ggml_tensor * w_gate, ggml_tensor * w_gate_up, ggml_tensor * w_down, ggml_tensor * ids) {
+        ggml_tensor * gate = nullptr;
+        ggml_tensor * up   = nullptr;
+        if (w_gate_up) {
+            ggml_tensor * gu = build_lora_mm_id(w_gate_up, cur, ids);                        // [2*n_ff, n_used, n_tok]
+            const int64_t n_ff = gu->ne[0] / 2;
+            gate = ggml_view_3d(ctx0, gu, n_ff, gu->ne[1], gu->ne[2], gu->nb[1], gu->nb[2], 0);
+            up   = ggml_view_3d(ctx0, gu, n_ff, gu->ne[1], gu->ne[2], gu->nb[1], gu->nb[2], n_ff * gu->nb[0]);
+        } else {
+            up   = build_lora_mm_id(w_up,   cur, ids);                                        // [n_ff, n_used, n_tok]
+            gate = build_lora_mm_id(w_gate, cur, ids);
+        }
+        ggml_tensor * act = ggml_swiglu_split(ctx0, gate, up);
+        return build_lora_mm_id(w_down, act, ids);                                            // [n_embd, n_used, n_tok]
+    };
+
+    // hot branch first (GPU), then the cold branch (CPU); the original tensors are the model's own
+    ggml_tensor * ex_hot = branch(pt->up, pt->gate, pt->gate_up, pt->down, ids_hot);
+    cb(ex_hot, "ffn_moe_hot_down", il);
+    ggml_build_forward_expand(gf, ex_hot);
+
+    ggml_tensor * ex_cold = branch(pt->orig_up, pt->orig_gate, pt->orig_gate_up, pt->orig_down, ids_cold);
+    cb(ex_cold, "ffn_moe_cold_down", il);
+    ggml_build_forward_expand(gf, ex_cold);
+
+    ggml_tensor * experts = ggml_add(ctx0, ex_hot, ex_cold);      // exact: one of the two is zero in every (expert, token) slot
+    cb(experts, "ffn_moe_down", il);
+    experts = ggml_mul(ctx0, experts, weights);
+    cb(experts, "ffn_moe_weighted", il);
+    ggml_build_forward_expand(gf, experts);
+
+    // sum over the selected experts, exactly as the stock code does it
+    const uint32_t n_used_il = hparams.n_expert_used(il);
+    ggml_tensor * moe_out = nullptr;
+    for (uint32_t i = 0; i < n_used_il; ++i) {
+        ggml_tensor * v = ggml_view_2d(ctx0, experts, n_embd_, n_tok, experts->nb[2], i * experts->nb[1]);
+        ggml_build_forward_expand(gf, v);
+        moe_out = moe_out ? ggml_add(ctx0, moe_out, v) : v;
+        if (i > 0) {
+            ggml_build_forward_expand(gf, moe_out);
+        }
+    }
+    if (n_used_il == 1) {
+        moe_out = ggml_cont(ctx0, moe_out);
+    }
+    cb(moe_out, "ffn_moe_out", il);
+    return moe_out;
+}
