+// E0 live hit counter (PELIAS_TIER_HITS=1): per layer, hits = selected experts found in the bank; "1" = single-token batches, "N" = batches of 2..31 tokens
+struct hit_acc { uint64_t hit1 = 0, tot1 = 0, hitN = 0, totN = 0; };
+std::map<int, hit_acc>                                                           g_hits;
+
 }  // namespace
 
 const pelias_tier_layer * pelias_tier_find(const ggml_tensor * down_exps) {
@@ -97,6 +101,42 @@ const pelias_tier_layer * pelias_tier_find(const ggml_tensor * down_exps) {
     return it == g_by_down.end() ? nullptr : it->second;
 }
 
+bool pelias_tier_hits_enabled() {
+    static const bool on = pelias_tier_enabled() && env_long("PELIAS_TIER_HITS", 0) != 0;
+    return on;
+}
+
+// ask phase: true only for the cold-branch id tensors ("pelias_ids_cold-<layer>"); data phase: count the -1 entries (= experts held in the bank)
+bool pelias_tier_eval_cb(struct ggml_tensor * t, bool ask, void * /*user_data*/) {
+    if (std::strncmp(t->name, "pelias_ids_cold", 15) != 0) {
+        return ask ? false : true;
+    }
+    if (ask) {
+        return true;
+    }
+    int il = -1;
+    if (std::sscanf(t->name, "pelias_ids_cold-%d", &il) != 1 || il < 0 || t->type != GGML_TYPE_I32) {
+        return true;
+    }
+    const int64_t n = ggml_nelements(t);
+    std::vector<int32_t> ids((size_t) n);
+    ggml_backend_tensor_get(t, ids.data(), 0, (size_t) n * sizeof(int32_t));
+    uint64_t hit = 0;
+    for (const int32_t x : ids) {
+        hit += (x == -1) ? 1 : 0;
+    }
+    std::lock_guard<std::mutex> lk(g_mu);
+    hit_acc & a = g_hits[il];
+    if (t->ne[1] == 1) {
+        a.hit1 += hit;
+        a.tot1 += (uint64_t) n;
+    } else {
+        a.hitN += hit;
+        a.totN += (uint64_t) n;
+    }
+    return true;
+}
+
