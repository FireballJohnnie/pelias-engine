+                uint64_t h1 = 0, t1 = 0, hN = 0, tN = 0;
+                std::fprintf(f, ",\n  \"hit_counts_by_layer\": {");
+                bool firstl = true;
+                for (const auto & kv : g_hits) {
+                    std::fprintf(f, "%s\"%d\": [%llu, %llu, %llu, %llu]", firstl ? "" : ", ", kv.first, (unsigned long long) kv.second.hit1,
+                                 (unsigned long long) kv.second.tot1, (unsigned long long) kv.second.hitN, (unsigned long long) kv.second.totN);
+                    firstl = false;
+                    h1 += kv.second.hit1; t1 += kv.second.tot1; hN += kv.second.hitN; tN += kv.second.totN;
+                }
+                std::fprintf(f, "},\n  \"hit_counts_layout\": \"layer: [hits_1token, selected_1token, hits_2to31tokens, selected_2to31tokens]\"");
+                std::fprintf(f, ",\n  \"hit_rate_1token\": %.6f, \"hit_rate_2to31tokens\": %.6f", t1 ? (double) h1 / (double) t1 : -1.0, tN ? (double) hN / (double) tN : -1.0);
+            }
+            std::fprintf(f, "\n}\n");
             std::fclose(f);
