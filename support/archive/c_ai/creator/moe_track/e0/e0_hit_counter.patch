diff --git a/src/llama-pelias-tier.h b/src/llama-pelias-tier.h
index 136f8a5..51492b7 100755
--- a/src/llama-pelias-tier.h
+++ b/src/llama-pelias-tier.h
@@ -62,3 +62,10 @@ const pelias_tier_layer * pelias_tier_find(const ggml_tensor * down_exps);
 // Diagnostics: called each time a dual-branch graph is built for a layer (graphs are rebuilt when the batch shape changes, not every token).
 // If PELIAS_TIER_STATS_FILE is set, a small JSON file with the counts is written when the model is freed.
 void pelias_tier_note_dual_build(int il, int n_tokens);
+
+// E0 measurement only: live hit counter. Active only when PELIAS_HOT_SET is set AND PELIAS_TIER_HITS=1.
+// It reads the cold-branch id tensor of every dual-branch layer (an id of -1 means the expert was in the bank = a hit) through ggml's eval callback.
+// The callback makes the scheduler stop after each of those nodes, so a counted run is SLOWER: use it to measure the hit rate, never the speed.
+// If PELIAS_TIER_STATS_FILE is set the counts are added to that JSON file when the model is freed.
+bool pelias_tier_hits_enabled();
+bool pelias_tier_eval_cb(struct ggml_tensor * t, bool ask, void * user_data);
