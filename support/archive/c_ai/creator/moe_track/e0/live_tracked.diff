+        ggml_tensor * gate = nullptr;
+        ggml_tensor * up   = nullptr;
+        if (w_gate_up) {
+            ggml_tensor * gu = pin(build_lora_mm_id(w_gate_up, cur, ids));                        // [2*n_ff, n_used, n_tok]
+            const int64_t n_ff = gu->ne[0] / 2;
